DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# Túnel ngrok de demostración. En un servidor real, dejar ambas en 0.
# ALLOW_NGROK acepta los dominios públicos de ngrok (la URL gratuita cambia).
# BEHIND_PROXY hace que Django reconozca el HTTPS que termina ngrok.
DJANGO_ALLOW_NGROK=1
DJANGO_BEHIND_PROXY=1

# Opcional. Hostname exacto del túnel, con o sin https://.
# Si DJANGO_ALLOW_NGROK=0, solo este host queda habilitado.
# DJANGO_NGROK_DOMAIN=abcd-12-34.ngrok-free.app
# Orígenes extra para CSRF, separados por coma (siempre con http:// o https://).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://reclamos.ejemplo.gov.py

POSTGRES_DB=db_reclamos
POSTGRES_USER=usuario_django
POSTGRES_PASSWORD=cambiar

DB_NAME=db_reclamos
DB_USER=usuario_django
DB_PASSWORD=cambiar
DB_HOST=db
DB_PORT=5432

# Envío de correos (recuperación de contraseña). Sin estas variables,
# los correos se muestran en `docker compose logs web`.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=contraseña_de_aplicacion
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Junta de Saneamiento de Bella Vista <tu_correo@gmail.com>

# Mapa del alta de reclamos zonales. No commitear una clave real.
# GOOGLE_MAPS_API_KEY=
